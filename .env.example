# DEV
BACKEND_PORT=9000
FRONTEND_PORT=9001

# DOCKER (compose.yaml; see docs/deployment.md)
COMPOSE_PROJECT_NAME=hearfolio-cloud
# Image the server runs; the deploy job pins it to a digest.
# APP_IMAGE=cr.yandex/<registry-id>/<image>@sha256:...
APP_ENTRY_PORT=127.0.0.1:8080
# Optional; when set, Redis requires it and compose builds the Redis URLs with it (use URL-safe characters).
REDIS_PASSWORD=

# ROOT
DEBUG=True
TASKIQ_WORKERS=1
BACKEND_WORKERS=2
TASKIQ_UPDATE_INTERVAL=30

SECRET_KEY=please-change-me-use-a-long-random-string-with-words-and-letters
ENCRYPTION_KEY=change-me-32-characters-minimum!
PASSWORD_PEPPER=

SQL_DATABASE=hearfolio-cloud-db
SQL_HOST=localhost
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_PORT=5432

REDIS_URL=redis://localhost:6379/0
BROKER_REDIS_URL=redis://localhost:6379/1

# LOGGING (json in production)
LOG_FORMAT=text
LOG_LEVEL=INFO
# OTEL_ENABLED=False
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=hearfolio-cloud

# AUTH (defaults shown)
# PASSWORD_MIN_LENGTH=8
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# JWT_ACCEPT_LEGACY_TOKENS=True

# HEARFOLIO
# Public origin of this instance: invite links and the OAuth URLs announced by /.well-known/hearfolio.
# Empty: derived from the request (fine locally; set it behind a proxy, e.g. https://rec.example.com).
PUBLIC_URL=
# INSTANCE_NAME=Hearfolio
# Oldest app version allowed to connect (announced by /.well-known/hearfolio)
# MIN_APP_VERSION=0.10.0
# Upload plan announced to the apps: single PUT below the threshold, S3 multipart parts above it
# UPLOAD_MULTIPART_THRESHOLD_BYTES=16777216
# UPLOAD_PART_SIZE_BYTES=8388608
# Invite link lifetime and the per-IP limit of failed invite/OAuth token attempts
# INVITE_EXPIRE_DAYS=7
# PUBLIC_RATE_LIMIT_ATTEMPTS=20
# PUBLIC_RATE_LIMIT_WINDOW_SECONDS=900
# Allow the organization AI base URL to point at private/loopback addresses (a self-hosted LLM gateway inside the
# network). Off by default: an org admin could otherwise make the server call internal services.
# AI_ALLOW_PRIVATE_BASE_URLS=False

# FRONTEND
# Browsers call the API on the page origin (`/api/v1`, `/ws`): Caddy in the image, the Nuxt dev proxy in `make run-frontend`.
# FastAPI as seen from the Nuxt server (SSR and the dev proxy). Default: http://localhost:$BACKEND_PORT in dev,
# http://127.0.0.1:8000 in the image.
# NUXT_API_INTERNAL_URL=
COOKIE_SECURE=False

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_PUBLIC_URL=

# OTHER
